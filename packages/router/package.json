{
  "name": "meritrouter",
  "version": "0.1.0",
  "description": "MeritRouter: bounded model delegation with enforced repository scope, budgets and verification.",
  "homepage": "https://github.com/aidens113/MeritRouter#readme",
  "repository": { "type": "git", "url": "https://github.com/aidens113/MeritRouter.git" },
  "bugs": { "url": "https://github.com/aidens113/MeritRouter/issues" },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "meritrouter": "./dist/cli.js"
  },
  "files": [
    "dist",
    "examples",
    "evals",
    "charters",
    "bundled-panel/.next",
    "bundled-panel/package.json",
    "bundled-panel/next.config.mjs",
    "bundled-panel/public",
    "bundled-panel/runtime-modules"
  ],
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.build.json && vitest run",
    "package:build": "node scripts/package-build.mjs",
    "prepack": "node scripts/package-build.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ajv": "^8.17.1",
    "better-sqlite3": "~12.11.1",
    "picomatch": "^4.0.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "lucide-react": "^1.59.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22",
    "@types/picomatch": "^4.0.3",
    "typescript": "~6.0.3",
    "vite": "~6.4.4",
    "vitest": "~3.2.7"
  }
}
