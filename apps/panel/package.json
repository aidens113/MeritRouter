{
  "name": "switchyard-panel",
  "version": "0.1.0",
  "private": true,
  "description": "Web panel for SwitchYard Router: models, routing, tasks, requests, provider keys, settings.",
  "type": "module",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 4477",
    "build": "node -e \"require('fs').rmSync('.next/dev',{recursive:true,force:true})\" && next build",
    "start": "next start -H 127.0.0.1 -p 4477",
    "typecheck": "tsc --noEmit",
    "test": "node -e \"\"",
    "seed:demo": "node scripts/seed-demo.mjs",
    "validate:live": "node scripts/validate-live.mjs"
  },
  "dependencies": {
    "better-sqlite3": "~12.11.1",
    "lucide-react": "^1.59.0",
    "next": "~16.4.2",
    "react": "^19.2",
    "react-dom": "^19.2",
    "server-only": "^0.0.1",
    "switchyard-router": "workspace:*",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3"
  }
}
